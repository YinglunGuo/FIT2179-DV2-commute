{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "Inter",
    "axis": {
      "gridColor": "#e7e2d8",
      "domainColor": "#bdb6a9",
      "tickColor": "#bdb6a9",
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  },
  "width": "container",
  "height": 280,
  "data": {
    "url": "data/wfh_state.json"
  },
  "mark": {
    "type": "bar",
    "tooltip": true,
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "x": {
      "field": "state",
      "type": "nominal",
      "sort": {
        "field": "pct",
        "order": "descending"
      },
      "title": null
    },
    "y": {
      "field": "pct",
      "type": "quantitative",
      "title": "% working from home"
    },
    "color": {
      "condition": {
        "test": "datum.state === 'VIC'",
        "value": "#2f8f5b"
      },
      "value": "#b7c0c5"
    },
    "tooltip": [
      {
        "field": "state",
        "title": "State / territory"
      },
      {
        "field": "pct",
        "title": "WFH %",
        "format": ".1f"
      }
    ]
  }
}