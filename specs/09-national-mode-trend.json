{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "National mode share over the 2011, 2016 and 2021 Censuses. Annotations call out the 2021 inflection where car driving fell, WFH surged and public transport halved.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "Inter",
    "axis": {
      "gridColor": "#e7e2d8",
      "domainColor": "#bdb6a9",
      "tickColor": "#bdb6a9",
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  },
  "width": "container",
  "height": 360,
  "padding": 6,
  "data": {
    "url": "data/national_trend.json"
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "point": {
          "filled": true,
          "size": 100,
          "stroke": "#fbfaf6",
          "strokeWidth": 1.5
        },
        "strokeWidth": 3,
        "tooltip": true
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": "Census year"
        },
        "y": {
          "field": "pct",
          "type": "quantitative",
          "title": "% of Australian workers",
          "scale": {
            "domain": [
              0,
              70
            ]
          }
        },
        "color": {
          "field": "mode",
          "type": "nominal",
          "scale": {
            "domain": [
              "Car driver",
              "Worked from home",
              "Public transport"
            ],
            "range": [
              "#c83f32",
              "#2f8f5b",
              "#1f6fb2"
            ]
          },
          "legend": {
            "title": "Mode",
            "orient": "bottom"
          }
        },
        "tooltip": [
          {
            "field": "mode",
            "title": "Mode"
          },
          {
            "field": "year",
            "title": "Census"
          },
          {
            "field": "pct",
            "title": "% workers",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === '2021' || datum.year === '2011'"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 11,
        "fontWeight": 700
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "pct",
          "type": "quantitative"
        },
        "color": {
          "field": "mode",
          "type": "nominal",
          "scale": {
            "domain": [
              "Car driver",
              "Worked from home",
              "Public transport"
            ],
            "range": [
              "#c83f32",
              "#2f8f5b",
              "#1f6fb2"
            ]
          },
          "legend": null
        },
        "text": {
          "field": "pct",
          "format": ".1f"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": "2021",
            "y": 38,
            "label": "Pandemic Census:\nWFH overtakes PT\nfor the first time"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#172026",
        "lineBreak": "\n"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "ordinal"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "x": "2016",
            "y": 65,
            "label": "Peak car · 62.0%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#7a3c33"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "ordinal"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
