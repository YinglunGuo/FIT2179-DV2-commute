{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "Inter",
    "axis": {
      "gridColor": "#e7e2d8",
      "domainColor": "#bdb6a9",
      "tickColor": "#bdb6a9",
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  },
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/active_transport.json"
  },
  "mark": {
    "type": "area",
    "opacity": 0.78,
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Census year",
      "axis": {
        "format": "d"
      }
    },
    "y": {
      "field": "count",
      "type": "quantitative",
      "title": "Workers",
      "stack": "zero",
      "axis": {
        "format": "~s"
      }
    },
    "color": {
      "field": "type",
      "type": "nominal",
      "scale": {
        "domain": [
          "Walking",
          "Cycling"
        ],
        "range": [
          "#d9852b",
          "#7b4fa1"
        ]
      },
      "legend": {
        "title": "Active mode",
        "orient": "top-right"
      }
    },
    "tooltip": [
      {
        "field": "year",
        "title": "Year",
        "format": "d"
      },
      {
        "field": "type",
        "title": "Mode"
      },
      {
        "field": "count",
        "title": "Workers",
        "format": ",d"
      }
    ]
  }
}