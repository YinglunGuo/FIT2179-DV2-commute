{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Small multiples: Working-from-home rate by state and territory across all Australian Census years 1976-2021. The 2021 spike isolates a structural break that decades of prior data did not show.",
  "config": {
    "background": null,
    "font": "Inter",
    "axis": {
      "gridColor": "#e7e2d8",
      "domainColor": "#bdb6a9",
      "tickColor": "#bdb6a9",
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 11,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  },
  "data": {
    "url": "data/wfh_state_trend.json"
  },
  "facet": {
    "field": "state",
    "type": "nominal",
    "columns": 4,
    "sort": [
      "NSW",
      "VIC",
      "QLD",
      "ACT",
      "SA",
      "TAS",
      "WA",
      "NT"
    ],
    "header": {
      "labelFontSize": 12,
      "labelFontWeight": 700,
      "labelColor": "#172026",
      "title": null
    }
  },
  "spec": {
    "width": 170,
    "height": 110,
    "layer": [
      {
        "mark": {
          "type": "area",
          "color": "#cfd9da",
          "opacity": 0.7,
          "line": false
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative",
            "scale": {
              "domain": [
                1976,
                2021
              ]
            },
            "axis": {
              "format": "d",
              "values": [
                1976,
                1996,
                2021
              ],
              "title": null
            }
          },
          "y": {
            "field": "pct",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                33
              ]
            },
            "axis": {
              "title": null,
              "values": [
                0,
                10,
                20,
                30
              ],
              "format": "d",
              "tickCount": 4
            }
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "color": "#5e6a71",
          "strokeWidth": 1.5
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative"
          },
          "y": {
            "field": "pct",
            "type": "quantitative"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.year === 2021"
          }
        ],
        "mark": {
          "type": "point",
          "filled": true,
          "size": 80,
          "color": "#c83f32",
          "stroke": "#fbfaf6",
          "strokeWidth": 1.5
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative"
          },
          "y": {
            "field": "pct",
            "type": "quantitative"
          },
          "tooltip": [
            {
              "field": "state",
              "title": "State / territory"
            },
            {
              "field": "year",
              "title": "Year"
            },
            {
              "field": "pct",
              "title": "WFH %",
              "format": ".1f"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "datum.year === 2021"
          }
        ],
        "mark": {
          "type": "text",
          "align": "right",
          "dx": -6,
          "dy": -8,
          "fontSize": 11,
          "fontWeight": 800,
          "color": "#c83f32"
        },
        "encoding": {
          "x": {
            "field": "year",
            "type": "quantitative"
          },
          "y": {
            "field": "pct",
            "type": "quantitative"
          },
          "text": {
            "field": "pct",
            "format": ".1f"
          }
        }
      }
    ]
  }
}
