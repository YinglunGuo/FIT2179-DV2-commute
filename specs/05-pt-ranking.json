{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "Inter",
    "axis": {
      "gridColor": "#e7e2d8",
      "domainColor": "#bdb6a9",
      "tickColor": "#bdb6a9",
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  },
  "width": "container",
  "height": 460,
  "data": {
    "url": "data/victoria_areas.json"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "tooltip": true,
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "y": {
          "field": "name",
          "type": "nominal",
          "sort": {
            "field": "ptPct",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelLimit": 150
          }
        },
        "x": {
          "field": "ptPct",
          "type": "quantitative",
          "title": "% using public transport"
        },
        "color": {
          "field": "zone",
          "type": "nominal",
          "scale": {
            "domain": [
              "Inner city",
              "Inner suburb",
              "Middle suburb",
              "Outer suburb",
              "Peri-urban",
              "Regional"
            ],
            "range": [
              "#063b63",
              "#1f6fb2",
              "#4a9ad4",
              "#80bfe6",
              "#f0aa4f",
              "#9e7c5a"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "name",
            "title": "Area"
          },
          {
            "field": "zone",
            "title": "Area type"
          },
          {
            "field": "ptPct",
            "title": "PT use %",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeDash": [
          4,
          4
        ],
        "color": "#555"
      },
      "encoding": {
        "x": {
          "datum": 4.4
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "dy": -170,
        "fontSize": 11,
        "color": "#555"
      },
      "data": {
        "values": [
          {
            "x": 4.4,
            "label": "Victoria average 4.4%"
          }
        ]
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}