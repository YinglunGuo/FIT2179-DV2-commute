{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "WFH share by state/territory, 2021. Victoria highlighted. Reference rule shows the Australian average (21.0%). The lockdown vs non-lockdown grouping is annotated.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "Inter",
    "axis": {
      "gridColor": "#e7e2d8",
      "domainColor": "#bdb6a9",
      "tickColor": "#bdb6a9",
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  },
  "width": "container",
  "height": 320,
  "padding": 6,
  "data": {
    "url": "data/wfh_state.json"
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "tooltip": true,
        "cornerRadiusEnd": 3
      },
      "encoding": {
        "x": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "pct",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelFontWeight": 700
          }
        },
        "y": {
          "field": "pct",
          "type": "quantitative",
          "title": "% working from home",
          "scale": {
            "domain": [
              0,
              35
            ]
          }
        },
        "color": {
          "condition": {
            "test": "datum.state === 'VIC'",
            "value": "#2f8f5b"
          },
          "value": "#b7c0c5"
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State / territory"
          },
          {
            "field": "pct",
            "title": "WFH %",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "dy": -8,
        "fontWeight": 700,
        "fontSize": 11,
        "color": "#172026"
      },
      "encoding": {
        "x": {
          "field": "state",
          "type": "nominal",
          "sort": {
            "field": "pct",
            "order": "descending"
          }
        },
        "y": {
          "field": "pct",
          "type": "quantitative"
        },
        "text": {
          "field": "pct",
          "format": ".1f"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "y": 21.0
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#5e6a71",
        "strokeDash": [
          4,
          4
        ]
      },
      "encoding": {
        "y": {
          "field": "y",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "y": 21.0,
            "label": "Australia · 21.0%"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "dy": -6,
        "fontSize": 11,
        "color": "#5e6a71",
        "fontStyle": "italic"
      },
      "encoding": {
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "x": {
          "value": 0
        },
        "text": {
          "field": "label"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "Lockdown on Census day → high WFH",
            "x": "NSW",
            "y": 34
          },
          {
            "label": "No lockdown → low WFH",
            "x": "WA",
            "y": 18
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#172026"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "nominal",
          "sort": {
            "field": "pct",
            "order": "descending"
          }
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
