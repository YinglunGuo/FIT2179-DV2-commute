{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Grid cartogram of 19 Victorian LGAs. Each LGA occupies an equal-area square placed at a schematic geographic position — Inner city in the centre, Regional at the edges. Colour encodes PT use (%). Each cell prints LGA name and value; this idiom guarantees no overlap, unlike the geographic bubble map.",
  "config": {
    "background": null,
    "font": "Inter",
    "axis": {
      "gridColor": "#e7e2d8",
      "domainColor": "#bdb6a9",
      "tickColor": "#bdb6a9",
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  },
  "width": "container",
  "height": 460,
  "padding": {
    "top": 30,
    "right": 24,
    "bottom": 60,
    "left": 24
  },
  "data": {
    "url": "data/lga_grid.json"
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "tooltip": true,
        "stroke": "#fbfaf6",
        "strokeWidth": 4,
        "cornerRadius": 6
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "axis": null,
          "scale": {
            "domain": [
              0,
              1,
              2,
              3,
              4,
              5
            ],
            "paddingInner": 0.06,
            "paddingOuter": 0.04
          }
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "axis": null,
          "scale": {
            "domain": [
              0,
              1,
              2,
              3,
              4
            ],
            "paddingInner": 0.06,
            "paddingOuter": 0.04
          }
        },
        "color": {
          "field": "ptPct",
          "type": "quantitative",
          "scale": {
            "scheme": "blues",
            "domainMin": 0,
            "domainMax": 17
          },
          "legend": {
            "title": "% using public transport (Census 2021)",
            "orient": "bottom",
            "gradientLength": 320,
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {
            "field": "name",
            "title": "LGA"
          },
          {
            "field": "zone",
            "title": "Zone"
          },
          {
            "field": "ptPct",
            "title": "PT %",
            "format": ".1f"
          },
          {
            "field": "carPct",
            "title": "Drove %",
            "format": ".1f"
          },
          {
            "field": "wfhPct",
            "title": "WFH %",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 12,
        "fontWeight": 700,
        "align": "center",
        "baseline": "bottom",
        "dy": -6
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "scale": {
            "domain": [
              0,
              1,
              2,
              3,
              4,
              5
            ]
          }
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "scale": {
            "domain": [
              0,
              1,
              2,
              3,
              4
            ]
          }
        },
        "text": {
          "field": "short"
        },
        "color": {
          "condition": {
            "test": "datum.ptPct > 9",
            "value": "#fbfaf6"
          },
          "value": "#172026"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 16,
        "fontWeight": 800,
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "scale": {
            "domain": [
              0,
              1,
              2,
              3,
              4,
              5
            ]
          }
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "scale": {
            "domain": [
              0,
              1,
              2,
              3,
              4
            ]
          }
        },
        "text": {
          "field": "ptPct",
          "format": ".1f"
        },
        "color": {
          "condition": {
            "test": "datum.ptPct > 9",
            "value": "#fbfaf6"
          },
          "value": "#0f1e34"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 9,
        "fontStyle": "italic",
        "align": "center",
        "baseline": "top",
        "dy": 22
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "scale": {
            "domain": [
              0,
              1,
              2,
              3,
              4,
              5
            ]
          }
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "scale": {
            "domain": [
              0,
              1,
              2,
              3,
              4
            ]
          }
        },
        "text": {
          "field": "zone"
        },
        "color": {
          "condition": {
            "test": "datum.ptPct > 9",
            "value": "#dde6ee"
          },
          "value": "#7a716b"
        }
      }
    }
  ]
}
