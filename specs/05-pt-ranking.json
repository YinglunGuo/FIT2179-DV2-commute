{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ranked bar chart of Victorian LGAs by 2021 public transport share. Reference rule marks the Victoria state average.",
  "autosize": { "type": "fit", "contains": "padding" },
  "config": {
    "background": null,
    "font": "Inter",
    "axis": { "gridColor": "#e7e2d8", "domainColor": "#bdb6a9", "tickColor": "#bdb6a9", "labelColor": "#344047", "titleColor": "#172026", "titleFontSize": 12, "titleFontWeight": 600 },
    "legend": { "labelColor": "#344047", "titleColor": "#172026", "titleFontSize": 12 },
    "view": { "stroke": null }
  },
  "width": "container",
  "height": 500,
  "padding": 6,
  "data": { "url": "data/victoria_areas.json" },
  "layer": [
    {
      "mark": { "type": "bar", "tooltip": true, "cornerRadiusEnd": 3 },
      "encoding": {
        "y": { "field": "name", "type": "nominal", "sort": { "field": "ptPct", "order": "descending" }, "title": null, "axis": { "labelLimit": 170 } },
        "x": { "field": "ptPct", "type": "quantitative", "title": "% using public transport", "scale": { "domain": [0, 18] } },
        "color": {
          "field": "zone",
          "type": "nominal",
          "scale": {
            "domain": ["Inner city", "Inner suburb", "Middle suburb", "Outer suburb", "Peri-urban", "Regional"],
            "range": ["#063b63", "#1f6fb2", "#4a9ad4", "#80bfe6", "#f0aa4f", "#9e7c5a"]
          },
          "legend": { "title": "Area type", "orient": "bottom", "columns": 6 }
        },
        "tooltip": [
          { "field": "name", "title": "Area" },
          { "field": "zone", "title": "Area type" },
          { "field": "ptPct", "title": "PT use %", "format": ".1f" }
        ]
      }
    },
    {
      "mark": { "type": "text", "align": "left", "dx": 4, "fontSize": 10, "color": "#172026", "fontWeight": 600 },
      "encoding": {
        "y": { "field": "name", "type": "nominal", "sort": { "field": "ptPct", "order": "descending" } },
        "x": { "field": "ptPct", "type": "quantitative" },
        "text": { "field": "ptPct", "format": ".1f" }
      }
    },
    {
      "data": { "values": [{ "x": 4.3 }] },
      "mark": { "type": "rule", "strokeDash": [4, 4], "color": "#555", "strokeWidth": 1.2 },
      "encoding": { "x": { "field": "x", "type": "quantitative" } }
    },
    {
      "data": { "values": [{ "x": 4.3, "label": "Victoria average · 4.3%" }] },
      "mark": { "type": "text", "align": "left", "dx": 6, "dy": -8, "fontSize": 11, "color": "#555", "fontStyle": "italic" },
      "encoding": { "x": { "field": "x", "type": "quantitative" }, "text": { "field": "label" }, "y": { "value": 5 } }
    }
  ]
}
