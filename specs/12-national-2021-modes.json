{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Full 2021 national mode-of-travel hierarchy. The chart shows just how dominant car-as-driver and WFH are compared with every other mode.",
  "autosize": { "type": "fit", "contains": "padding" },
  "config": {
    "background": null,
    "font": "Inter",
    "axis": { "gridColor": "#e7e2d8", "domainColor": "#bdb6a9", "tickColor": "#bdb6a9", "labelColor": "#344047", "titleColor": "#172026", "titleFontSize": 12, "titleFontWeight": 600 },
    "legend": { "labelColor": "#344047", "titleColor": "#172026", "titleFontSize": 12 },
    "view": { "stroke": null }
  },
  "width": "container",
  "height": 420,
  "padding": 6,
  "data": { "url": "data/national_modes.json" },
  "layer": [
    {
      "mark": { "type": "bar", "tooltip": true, "cornerRadiusEnd": 3 },
      "encoding": {
        "x": { "field": "pct", "type": "quantitative", "title": "% of Australian workers", "scale": { "domain": [0, 60] } },
        "y": { "field": "mode", "type": "nominal", "sort": { "field": "pct", "order": "descending" }, "title": null, "axis": { "labelFontWeight": 600, "labelLimit": 170 } },
        "color": {
          "field": "mode",
          "type": "nominal",
          "scale": {
            "domain": [
              "Car (as driver)", "Worked from home", "Did not go to work",
              "Car (as passenger)", "Walked only", "Train", "Bus",
              "Bicycle", "Truck", "Other mode", "Not stated",
              "Motorbike / scooter", "Tram / light rail", "Taxi / ride-share", "Ferry"
            ],
            "range": [
              "#c83f32", "#2f8f5b", "#9aa6ac",
              "#e5a09a", "#d9852b", "#063b63", "#1f6fb2",
              "#7b4fa1", "#8b6f47", "#82909a", "#a8a59c",
              "#5a91c2", "#80bfe6", "#cd9b6a", "#73a3b8"
            ]
          },
          "legend": null
        },
        "tooltip": [
          { "field": "mode", "title": "Mode" },
          { "field": "pct", "title": "% workers", "format": ".1f" }
        ]
      }
    },
    {
      "mark": { "type": "text", "align": "left", "dx": 4, "fontSize": 11, "fontWeight": 600, "color": "#172026" },
      "encoding": {
        "y": { "field": "mode", "type": "nominal", "sort": { "field": "pct", "order": "descending" } },
        "x": { "field": "pct", "type": "quantitative" },
        "text": { "field": "pct", "format": ".1f" }
      }
    },
    {
      "data": { "values": [{ "x": 56, "y": "Car (as driver)", "label": "Largest category" }, { "x": 26, "y": "Worked from home", "label": "Pandemic surge" }, { "x": 5.4, "y": "Train", "label": "All PT modes < 5%" }] },
      "mark": { "type": "text", "align": "left", "dx": 28, "fontSize": 11, "fontStyle": "italic", "color": "#5e6a71" },
      "encoding": {
        "y": { "field": "y", "type": "nominal", "sort": { "field": "pct", "order": "descending" } },
        "x": { "field": "x", "type": "quantitative" },
        "text": { "field": "label" }
      }
    }
  ]
}
