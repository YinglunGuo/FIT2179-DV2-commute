{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Three-panel geography view of Victoria 2021. (1) Victoria-wide proportional-symbol map with 100-point Natural Earth coastline. (2) Greater Melbourne inset — same source map cropped via projection so the 14 inner-Melbourne LGAs become legible. (3) Car-vs-PT scatter sharing the zone palette and showing the inverse relationship at a glance.",
  "config": {
    "background": null,
    "font": "Inter",
    "axis": { "gridColor": "#e7e2d8", "domainColor": "#bdb6a9", "tickColor": "#bdb6a9", "labelColor": "#344047", "titleColor": "#172026", "titleFontSize": 12, "titleFontWeight": 600 },
    "legend": { "labelColor": "#344047", "titleColor": "#172026", "titleFontSize": 12 },
    "view": { "stroke": null }
  },
  "hconcat": [
    {
      "vconcat": [
        {
          "title": { "text": "Victoria · all 19 LGAs", "anchor": "start", "fontSize": 13, "fontWeight": 700, "color": "#172026" },
          "width": 400,
          "height": 260,
          "projection": { "type": "mercator", "center": [144.7, -36.7], "scale": 2600 },
          "layer": [
            {
              "data": { "url": "data/victoria_outline.geojson", "format": { "type": "json", "property": "features" } },
              "mark": { "type": "geoshape", "fill": "#eee6da", "stroke": "#9f9587", "strokeWidth": 1 }
            },
            {
              "data": { "url": "data/victoria_areas.json" },
              "mark": { "type": "circle", "stroke": "#fffdf8", "strokeWidth": 0.9, "tooltip": true },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "size": { "field": "ptPct", "type": "quantitative", "scale": { "range": [40, 700] }, "legend": null },
                "color": {
                  "field": "zone", "type": "nominal",
                  "scale": {
                    "domain": ["Inner city", "Inner suburb", "Middle suburb", "Outer suburb", "Peri-urban", "Regional"],
                    "range": ["#063b63", "#1f6fb2", "#4a9ad4", "#80bfe6", "#f0aa4f", "#9e7c5a"]
                  },
                  "legend": null
                },
                "opacity": { "value": 0.92 },
                "tooltip": [
                  { "field": "name", "title": "Area" },
                  { "field": "zone", "title": "Zone" },
                  { "field": "ptPct", "title": "PT use %", "format": ".1f" }
                ]
              }
            },
            {
              "data": { "values": [
                { "lon": 143.86, "lat": -37.56, "label": "Ballarat" },
                { "lon": 144.28, "lat": -36.76, "label": "Bendigo" },
                { "lon": 145.40, "lat": -36.38, "label": "Shepparton" },
                { "lon": 144.35, "lat": -38.15, "label": "Geelong" }
              ] },
              "mark": { "type": "text", "dx": 10, "dy": -7, "fontSize": 10, "fontWeight": 600, "color": "#172026", "align": "left" },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "text": { "field": "label" }
              }
            },
            {
              "data": { "values": [ { "lon": 145.0, "lat": -37.95, "label": "↓ Greater Melbourne (zoomed below)" } ] },
              "mark": { "type": "text", "fontSize": 10, "fontWeight": 700, "color": "#1c3a5e", "align": "center", "fontStyle": "italic" },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "text": { "field": "label" }
              }
            }
          ]
        },
        {
          "title": { "text": "Greater Melbourne · inset zoom (Port Phillip Bay)", "anchor": "start", "fontSize": 13, "fontWeight": 700, "color": "#172026" },
          "width": 400,
          "height": 380,
          "projection": { "type": "mercator", "center": [145.05, -37.92], "scale": 18000 },
          "layer": [
            {
              "data": { "url": "data/victoria_outline.geojson", "format": { "type": "json", "property": "features" } },
              "mark": { "type": "geoshape", "fill": "#eee6da", "stroke": "#9f9587", "strokeWidth": 1.2 }
            },
            {
              "data": { "url": "data/victoria_areas.json" },
              "transform": [{ "filter": "datum.zone !== 'Regional'" }],
              "mark": { "type": "circle", "stroke": "#fffdf8", "strokeWidth": 1.5, "tooltip": true },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "size": { "field": "ptPct", "type": "quantitative", "scale": { "range": [180, 2400] }, "legend": null },
                "color": {
                  "field": "zone", "type": "nominal",
                  "scale": {
                    "domain": ["Inner city", "Inner suburb", "Middle suburb", "Outer suburb", "Peri-urban", "Regional"],
                    "range": ["#063b63", "#1f6fb2", "#4a9ad4", "#80bfe6", "#f0aa4f", "#9e7c5a"]
                  },
                  "legend": null
                },
                "opacity": { "value": 0.9 },
                "tooltip": [
                  { "field": "name", "title": "Area" },
                  { "field": "zone", "title": "Zone" },
                  { "field": "ptPct", "title": "PT use %", "format": ".1f" },
                  { "field": "carPct", "title": "Drove %", "format": ".1f" },
                  { "field": "wfhPct", "title": "WFH %", "format": ".1f" }
                ]
              }
            },
            {
              "data": { "url": "data/victoria_areas.json" },
              "transform": [{ "filter": "datum.zone !== 'Regional' && datum.zone !== 'Peri-urban'" }],
              "mark": { "type": "text", "dy": -22, "fontSize": 9, "fontWeight": 700, "color": "#172026", "align": "center" },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "text": { "field": "name" }
              }
            }
          ]
        }
      ]
    },
    {
      "title": { "text": "Drove vs PT — Victorian LGAs", "anchor": "start", "fontSize": 13, "fontWeight": 700, "color": "#172026" },
      "width": 380,
      "height": 660,
      "data": { "url": "data/victoria_areas.json" },
      "layer": [
        {
          "transform": [{ "regression": "ptPct", "on": "carPct" }],
          "mark": { "type": "line", "color": "#94918a", "strokeDash": [5, 5] },
          "encoding": {
            "x": { "field": "carPct", "type": "quantitative", "scale": { "domain": [10, 75] } },
            "y": { "field": "ptPct", "type": "quantitative", "scale": { "domain": [0, 20] } }
          }
        },
        {
          "mark": { "type": "point", "filled": true, "size": 160, "tooltip": true, "stroke": "#fbfaf6", "strokeWidth": 1.4 },
          "encoding": {
            "x": { "field": "carPct", "type": "quantitative", "title": "Drove to work (%)", "scale": { "domain": [10, 75] } },
            "y": { "field": "ptPct", "type": "quantitative", "title": "Used public transport (%)", "scale": { "domain": [0, 20] } },
            "color": {
              "field": "zone", "type": "nominal",
              "scale": {
                "domain": ["Inner city", "Inner suburb", "Middle suburb", "Outer suburb", "Peri-urban", "Regional"],
                "range": ["#063b63", "#1f6fb2", "#4a9ad4", "#80bfe6", "#f0aa4f", "#9e7c5a"]
              },
              "legend": { "title": "Area type", "orient": "bottom", "columns": 3 }
            },
            "opacity": { "value": 0.9 },
            "tooltip": [
              { "field": "name", "title": "Area" },
              { "field": "zone", "title": "Zone" },
              { "field": "carPct", "title": "Drove %", "format": ".1f" },
              { "field": "ptPct", "title": "PT %", "format": ".1f" },
              { "field": "wfhPct", "title": "WFH %", "format": ".1f" }
            ]
          }
        },
        {
          "transform": [{ "filter": "datum.name === 'Melbourne City' || datum.name === 'Wyndham' || datum.name === 'Ballarat' || datum.name === 'Port Phillip' || datum.name === 'Greater Geelong' || datum.name === 'Yarra'" }],
          "mark": { "type": "text", "dx": 10, "dy": -10, "fontSize": 10, "fontWeight": 700, "color": "#172026", "align": "left" },
          "encoding": {
            "x": { "field": "carPct", "type": "quantitative" },
            "y": { "field": "ptPct", "type": "quantitative" },
            "text": { "field": "name" }
          }
        },
        {
          "data": { "values": [
            { "x": 22, "y": 18.6, "label": "Inverse relationship:" },
            { "x": 22, "y": 17.3, "label": "more driving = less PT" }
          ] },
          "mark": { "type": "text", "fontSize": 10, "fontStyle": "italic", "color": "#5e6a71", "align": "left" },
          "encoding": {
            "x": { "field": "x", "type": "quantitative" },
            "y": { "field": "y", "type": "quantitative" },
            "text": { "field": "label" }
          }
        }
      ]
    }
  ],
  "resolve": { "scale": { "color": "independent" } }
}
