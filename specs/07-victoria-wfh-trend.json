{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Victorian work-from-home rate every Australian Census from 1976 to 2021. Annotation highlights the structural break in 2021.",
  "autosize": { "type": "fit", "contains": "padding" },
  "config": {
    "background": null,
    "font": "Inter",
    "axis": { "gridColor": "#e7e2d8", "domainColor": "#bdb6a9", "tickColor": "#bdb6a9", "labelColor": "#344047", "titleColor": "#172026", "titleFontSize": 12, "titleFontWeight": 600 },
    "legend": { "labelColor": "#344047", "titleColor": "#172026", "titleFontSize": 12 },
    "view": { "stroke": null }
  },
  "width": "container",
  "height": 320,
  "padding": 6,
  "data": { "url": "data/wfh_vic_trend.json" },
  "layer": [
    {
      "mark": { "type": "area", "opacity": 0.18, "color": "#2f8f5b" },
      "encoding": {
        "x": { "field": "year", "type": "ordinal", "title": "Census year" },
        "y": { "field": "pct", "type": "quantitative", "title": "% Victorian workers working from home", "scale": { "domain": [0, 30] } }
      }
    },
    {
      "mark": { "type": "line", "color": "#2f8f5b", "strokeWidth": 4 },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "pct", "type": "quantitative" }
      }
    },
    {
      "mark": { "type": "point", "color": "#2f8f5b", "size": 110, "filled": true, "stroke": "#fbfaf6", "strokeWidth": 1.5, "tooltip": true },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "pct", "type": "quantitative" },
        "tooltip": [
          { "field": "year", "title": "Census year" },
          { "field": "pct", "title": "WFH %", "format": ".1f" }
        ]
      }
    },
    {
      "transform": [{ "filter": "datum.year === '2021' || datum.year === '2016' || datum.year === '1976'" }],
      "mark": { "type": "text", "dy": -14, "fontWeight": 700, "fontSize": 12, "color": "#1c5a3a" },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "pct", "type": "quantitative" },
        "text": { "field": "pct", "format": ".1f" }
      }
    },
    {
      "data": { "values": [{ "year": "2016", "pct": 14, "label": "Pre-pandemic baseline\nhovered around 5%\nfor 40 years" }] },
      "mark": { "type": "text", "align": "right", "dx": -8, "fontSize": 11, "color": "#5e6a71", "lineBreak": "\n" },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "pct", "type": "quantitative" },
        "text": { "field": "label" }
      }
    },
    {
      "data": { "values": [{ "year": "2021", "pct": 27, "label": "COVID-19 lockdown\non Census day\nlifted VIC to 25.7%" }] },
      "mark": { "type": "text", "align": "right", "dx": -8, "fontSize": 11, "fontWeight": 600, "color": "#1c5a3a", "lineBreak": "\n" },
      "encoding": {
        "x": { "field": "year", "type": "ordinal" },
        "y": { "field": "pct", "type": "quantitative" },
        "text": { "field": "label" }
      }
    }
  ]
}
