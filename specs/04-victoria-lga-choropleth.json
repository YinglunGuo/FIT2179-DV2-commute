{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Three-panel geography view of Victoria 2021, redesigned as a true choropleth. Each of the 19 selected LGAs gets a Voronoi region clipped to Victoria's coastline and coloured by PT use. (1) Victoria-wide choropleth (2) Greater Melbourne inset (3) Drove-vs-PT scatter with the same zone palette.",
  "config": {
    "background": null,
    "font": "Inter",
    "axis": { "gridColor": "#e7e2d8", "domainColor": "#bdb6a9", "tickColor": "#bdb6a9", "labelColor": "#344047", "titleColor": "#172026", "titleFontSize": 12, "titleFontWeight": 600 },
    "legend": { "labelColor": "#344047", "titleColor": "#172026", "titleFontSize": 12 },
    "view": { "stroke": null }
  },
  "hconcat": [
    {
      "vconcat": [
        {
          "title": { "text": "Victoria — 19 selected LGAs · choropleth by PT use", "anchor": "start", "fontSize": 13, "fontWeight": 700, "color": "#172026" },
          "width": 440,
          "height": 300,
          "projection": { "type": "mercator", "center": [145.55, -36.55], "scale": 2350 },
          "layer": [
            {
              "data": { "url": "data/victoria_outline.geojson", "format": { "type": "json", "property": "features" } },
              "mark": { "type": "geoshape", "fill": "#f3ece0", "stroke": "#7d7164", "strokeWidth": 1.1 }
            },
            {
              "data": { "url": "data/lga_voronoi.geojson", "format": { "type": "json", "property": "features" } },
              "mark": { "type": "geoshape", "stroke": "#fbfaf6", "strokeWidth": 0.9, "tooltip": true },
              "encoding": {
                "color": {
                  "field": "ptPct",
                  "type": "quantitative",
                  "scale": { "scheme": "blues", "domainMin": 0, "domainMax": 17 },
                  "legend": { "title": "PT use (%)", "orient": "bottom-right", "gradientLength": 140, "titleFontSize": 11, "labelFontSize": 10 }
                },
                "tooltip": [
                  { "field": "name", "title": "Area" },
                  { "field": "zone", "title": "Zone" },
                  { "field": "ptPct", "title": "PT %", "format": ".1f" },
                  { "field": "carPct", "title": "Drove %", "format": ".1f" },
                  { "field": "wfhPct", "title": "WFH %", "format": ".1f" }
                ]
              }
            },
            {
              "data": { "values": [
                { "lon": 143.86, "lat": -37.56, "label": "Ballarat" },
                { "lon": 144.28, "lat": -36.76, "label": "Bendigo" },
                { "lon": 145.40, "lat": -36.38, "label": "Shepparton" },
                { "lon": 144.35, "lat": -38.15, "label": "Geelong" }
              ] },
              "mark": { "type": "text", "fontSize": 10, "fontWeight": 700, "color": "#fbfaf6" },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "text": { "field": "label" }
              }
            }
          ]
        },
        {
          "title": { "text": "Greater Melbourne — inner-suburb detail", "anchor": "start", "fontSize": 13, "fontWeight": 700, "color": "#172026" },
          "width": 440,
          "height": 400,
          "projection": { "type": "mercator", "center": [144.92, -37.78], "scale": 16500 },
          "layer": [
            {
              "data": { "url": "data/lga_voronoi.geojson", "format": { "type": "json", "property": "features" } },
              "mark": { "type": "geoshape", "stroke": "#fbfaf6", "strokeWidth": 1.5, "tooltip": true },
              "encoding": {
                "color": {
                  "field": "ptPct",
                  "type": "quantitative",
                  "scale": { "scheme": "blues", "domainMin": 0, "domainMax": 17 },
                  "legend": null
                },
                "tooltip": [
                  { "field": "name", "title": "Area" },
                  { "field": "zone", "title": "Zone" },
                  { "field": "ptPct", "title": "PT %", "format": ".1f" },
                  { "field": "carPct", "title": "Drove %", "format": ".1f" },
                  { "field": "wfhPct", "title": "WFH %", "format": ".1f" }
                ]
              }
            },
            {
              "data": { "url": "data/lga_voronoi.geojson", "format": { "type": "json", "property": "features" } },
              "transform": [{ "filter": "datum.properties.zone !== 'Regional'" }],
              "mark": { "type": "text", "fontSize": 10, "fontWeight": 700 },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "text": { "field": "name" },
                "color": {
                  "condition": { "test": "datum.properties.ptPct > 9", "value": "#fbfaf6" },
                  "value": "#172026"
                }
              }
            },
            {
              "data": { "url": "data/lga_voronoi.geojson", "format": { "type": "json", "property": "features" } },
              "transform": [{ "filter": "datum.properties.zone !== 'Regional'" }],
              "mark": { "type": "text", "fontSize": 10, "fontWeight": 800, "dy": 12 },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "text": { "field": "ptPct", "format": ".1f" },
                "color": {
                  "condition": { "test": "datum.properties.ptPct > 9", "value": "#fbfaf6" },
                  "value": "#0f1e34"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "title": { "text": "Drove vs PT — 19 selected Victorian LGAs", "anchor": "start", "fontSize": 13, "fontWeight": 700, "color": "#172026" },
      "width": 380,
      "height": 700,
      "data": { "url": "data/victoria_areas.json" },
      "layer": [
        {
          "transform": [{ "regression": "ptPct", "on": "carPct" }],
          "mark": { "type": "line", "color": "#94918a", "strokeDash": [5, 5] },
          "encoding": {
            "x": { "field": "carPct", "type": "quantitative", "scale": { "domain": [10, 75] } },
            "y": { "field": "ptPct", "type": "quantitative", "scale": { "domain": [0, 20] } }
          }
        },
        {
          "mark": { "type": "point", "filled": true, "size": 160, "tooltip": true, "stroke": "#fbfaf6", "strokeWidth": 1.4 },
          "encoding": {
            "x": { "field": "carPct", "type": "quantitative", "title": "Drove to work (%)", "scale": { "domain": [10, 75] } },
            "y": { "field": "ptPct", "type": "quantitative", "title": "Used public transport (%)", "scale": { "domain": [0, 20] } },
            "color": {
              "field": "zone", "type": "nominal",
              "scale": {
                "domain": ["Inner city", "Inner suburb", "Middle suburb", "Outer suburb", "Peri-urban", "Regional"],
                "range": ["#063b63", "#1f6fb2", "#4a9ad4", "#80bfe6", "#f0aa4f", "#9e7c5a"]
              },
              "legend": { "title": "Area type (zone)", "orient": "bottom", "columns": 3 }
            },
            "opacity": { "value": 0.92 },
            "tooltip": [
              { "field": "name", "title": "Area" },
              { "field": "zone", "title": "Zone" },
              { "field": "carPct", "title": "Drove %", "format": ".1f" },
              { "field": "ptPct", "title": "PT %", "format": ".1f" },
              { "field": "wfhPct", "title": "WFH %", "format": ".1f" }
            ]
          }
        },
        {
          "transform": [{ "filter": "datum.name === 'Melbourne City' || datum.name === 'Wyndham' || datum.name === 'Ballarat' || datum.name === 'Port Phillip' || datum.name === 'Greater Geelong' || datum.name === 'Yarra'" }],
          "mark": { "type": "text", "dx": 10, "dy": -10, "fontSize": 10, "fontWeight": 700, "color": "#172026", "align": "left" },
          "encoding": {
            "x": { "field": "carPct", "type": "quantitative" },
            "y": { "field": "ptPct", "type": "quantitative" },
            "text": { "field": "name" }
          }
        },
        {
          "data": { "values": [
            { "x": 22, "y": 18.6, "label": "Inverse relationship:" },
            { "x": 22, "y": 17.3, "label": "more driving = less PT" }
          ] },
          "mark": { "type": "text", "fontSize": 10, "fontStyle": "italic", "color": "#5e6a71", "align": "left" },
          "encoding": {
            "x": { "field": "x", "type": "quantitative" },
            "y": { "field": "y", "type": "quantitative" },
            "text": { "field": "label" }
          }
        }
      ]
    }
  ],
  "resolve": { "scale": { "color": "independent", "size": "independent" } }
}
