{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "Inter",
    "axis": {
      "gridColor": "#e7e2d8",
      "domainColor": "#bdb6a9",
      "tickColor": "#bdb6a9",
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  },
  "width": "container",
  "height": 300,
  "data": {
    "url": "data/victoria_modes.json"
  },
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 82,
        "outerRadius": 142,
        "tooltip": true,
        "stroke": "#fbfaf6",
        "strokeWidth": 2
      },
      "encoding": {
        "theta": {
          "field": "pct",
          "type": "quantitative"
        },
        "color": {
          "field": "mode",
          "type": "nominal",
          "scale": {
            "domain": [
              "Car travel",
              "Work from home",
              "Car passenger",
              "Public transport",
              "Walk only",
              "Walk / cycle",
              "Bicycle",
              "Truck",
              "Other / not stated"
            ],
            "range": [
              "#c83f32",
              "#2f8f5b",
              "#e5a09a",
              "#1f6fb2",
              "#d9852b",
              "#d9852b",
              "#7b4fa1",
              "#8b6f47",
              "#82909a"
            ]
          },
          "legend": {
            "title": "Travel mode",
            "orient": "bottom",
            "columns": 2
          }
        },
        "tooltip": [
          {
            "field": "mode",
            "title": "Mode"
          },
          {
            "field": "pct",
            "title": "% of Victorian workers",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 28,
        "fontWeight": 800,
        "color": "#172026"
      },
      "data": {
        "values": [
          {
            "label": "54.5%"
          }
        ]
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "dy": 28,
        "fontSize": 12,
        "color": "#5d686f"
      },
      "data": {
        "values": [
        {
          "label": "used car"
        }
      ]
    },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
