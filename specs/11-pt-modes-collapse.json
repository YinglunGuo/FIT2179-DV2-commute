{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "Inter",
    "axis": {
      "gridColor": "#e7e2d8",
      "domainColor": "#bdb6a9",
      "tickColor": "#bdb6a9",
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  },
  "width": "container",
  "height": 320,
  "data": {
    "url": "data/pt_modes.json"
  },
  "mark": {
    "type": "bar",
    "tooltip": true,
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": "Census year"
    },
    "y": {
      "field": "users",
      "type": "quantitative",
      "title": "Commuters",
      "axis": {
        "format": "~s"
      }
    },
    "color": {
      "field": "mode",
      "type": "nominal",
      "scale": {
        "domain": [
          "Train",
          "Bus",
          "Tram / ferry"
        ],
        "range": [
          "#063b63",
          "#1f6fb2",
          "#80bfe6"
        ]
      },
      "legend": {
        "title": "PT mode",
        "orient": "bottom"
      }
    },
    "xOffset": {
      "field": "mode"
    },
    "tooltip": [
      {
        "field": "mode",
        "title": "Mode"
      },
      {
        "field": "year",
        "title": "Year"
      },
      {
        "field": "users",
        "title": "Commuters",
        "format": ",d"
      }
    ]
  }
}