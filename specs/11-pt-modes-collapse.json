{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Public transport commuters in Australia by mode and Census year. The 2021 column shows a system-wide collapse, with train use falling 61% from 2016.",
  "autosize": { "type": "fit", "contains": "padding" },
  "config": {
    "background": null,
    "font": "Inter",
    "axis": { "gridColor": "#e7e2d8", "domainColor": "#bdb6a9", "tickColor": "#bdb6a9", "labelColor": "#344047", "titleColor": "#172026", "titleFontSize": 12, "titleFontWeight": 600 },
    "legend": { "labelColor": "#344047", "titleColor": "#172026", "titleFontSize": 12 },
    "view": { "stroke": null }
  },
  "width": "container",
  "height": 320,
  "padding": 6,
  "data": { "url": "data/pt_modes.json" },
  "layer": [
    {
      "mark": { "type": "bar", "tooltip": true, "cornerRadiusEnd": 3 },
      "encoding": {
        "x": { "field": "year", "type": "ordinal", "title": "Census year", "axis": { "labelFontWeight": 700 } },
        "y": { "field": "users", "type": "quantitative", "title": "Commuters on Census day", "axis": { "format": "~s" } },
        "color": {
          "field": "mode",
          "type": "nominal",
          "scale": { "domain": ["Train", "Bus", "Tram / ferry"], "range": ["#063b63", "#1f6fb2", "#80bfe6"] },
          "legend": { "title": "PT mode", "orient": "bottom" }
        },
        "xOffset": { "field": "mode" },
        "tooltip": [
          { "field": "mode", "title": "Mode" },
          { "field": "year", "title": "Census" },
          { "field": "users", "title": "Commuters", "format": ",d" }
        ]
      }
    },
    {
      "data": { "values": [{ "x": "2021", "y": 600000, "label": "Train −61%\nBus −43%\nTram/ferry −49%\n(vs 2016)" }] },
      "mark": { "type": "text", "align": "center", "fontSize": 11, "fontWeight": 600, "color": "#172026", "lineBreak": "\n" },
      "encoding": {
        "x": { "field": "x", "type": "ordinal" },
        "y": { "field": "y", "type": "quantitative" },
        "text": { "field": "label" }
      }
    },
    {
      "data": { "values": [{ "x": "2016", "y": 800000, "label": "Pre-COVID peak" }] },
      "mark": { "type": "text", "align": "center", "fontSize": 10, "fontStyle": "italic", "color": "#5e6a71" },
      "encoding": {
        "x": { "field": "x", "type": "ordinal" },
        "y": { "field": "y", "type": "quantitative" },
        "text": { "field": "label" }
      }
    }
  ]
}
