{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Three-panel linked geography view: (1) Victoria-wide bubble map with 100-point coastline outline, (2) Greater Melbourne inset where the dense inner-city cluster is finally legible, (3) car-vs-PT scatter sharing the same zone palette.",
  "config": {
    "background": null,
    "font": "Inter",
    "axis": { "gridColor": "#e7e2d8", "domainColor": "#bdb6a9", "tickColor": "#bdb6a9", "labelColor": "#344047", "titleColor": "#172026", "titleFontSize": 12, "titleFontWeight": 600 },
    "legend": { "labelColor": "#344047", "titleColor": "#172026", "titleFontSize": 12 },
    "view": { "stroke": null }
  },
  "hconcat": [
    {
      "vconcat": [
        {
          "title": { "text": "Victoria · all 19 LGAs", "anchor": "start", "fontSize": 12, "fontWeight": 700, "color": "#172026" },
          "width": 360,
          "height": 250,
          "projection": { "type": "mercator", "center": [145.0, -36.8], "scale": 2700 },
          "layer": [
            {
              "data": { "url": "data/victoria_outline.geojson", "format": { "type": "json", "property": "features" } },
              "mark": { "type": "geoshape", "fill": "#eee6da", "stroke": "#9f9587", "strokeWidth": 1.1 }
            },
            {
              "data": { "url": "data/victoria_areas.json" },
              "mark": { "type": "circle", "stroke": "#fffdf8", "strokeWidth": 1, "tooltip": true },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "size": { "field": "ptPct", "type": "quantitative", "scale": { "range": [30, 800] }, "legend": null },
                "color": {
                  "field": "zone", "type": "nominal",
                  "scale": {
                    "domain": ["Inner city", "Inner suburb", "Middle suburb", "Outer suburb", "Peri-urban", "Regional"],
                    "range": ["#063b63", "#1f6fb2", "#4a9ad4", "#80bfe6", "#f0aa4f", "#9e7c5a"]
                  },
                  "legend": null
                },
                "opacity": { "value": 0.9 },
                "tooltip": [
                  { "field": "name", "title": "Area" },
                  { "field": "zone", "title": "Zone" },
                  { "field": "ptPct", "title": "PT use %", "format": ".1f" }
                ]
              }
            },
            {
              "data": { "values": [
                { "lon": 143.86, "lat": -37.56, "label": "Ballarat" },
                { "lon": 144.28, "lat": -36.76, "label": "Bendigo" },
                { "lon": 145.40, "lat": -36.38, "label": "Shepparton" },
                { "lon": 144.35, "lat": -38.15, "label": "Geelong" }
              ] },
              "mark": { "type": "text", "dx": 8, "dy": -8, "fontSize": 10, "fontWeight": 600, "color": "#172026", "align": "left" },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "text": { "field": "label" }
              }
            },
            {
              "data": { "values": [
                { "lon": 145.0, "lat": -37.85, "label": "↓ Greater Melbourne (zoomed below)" }
              ] },
              "mark": { "type": "text", "dy": 16, "fontSize": 10, "fontWeight": 700, "color": "#1c3a5e", "align": "center", "fontStyle": "italic" },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "text": { "field": "label" }
              }
            }
          ]
        },
        {
          "title": { "text": "Greater Melbourne · inset zoom", "anchor": "start", "fontSize": 12, "fontWeight": 700, "color": "#172026" },
          "width": 360,
          "height": 320,
          "projection": { "type": "mercator", "center": [144.98, -37.85], "scale": 18000 },
          "layer": [
            {
              "data": { "values": [
                { "lon": [144.5, 145.45], "lat": [-38.4, -37.45] }
              ] },
              "mark": { "type": "rect", "fill": "#f4ede0", "stroke": "#cfc6b3", "strokeWidth": 1 },
              "encoding": {
                "longitude": { "datum": 144.5 },
                "latitude": { "datum": -37.45 },
                "longitude2": { "datum": 145.45 },
                "latitude2": { "datum": -38.4 }
              }
            },
            {
              "data": { "url": "data/victoria_areas.json" },
              "transform": [{ "filter": "datum.zone !== 'Regional' && datum.zone !== 'Peri-urban'" }],
              "mark": { "type": "circle", "stroke": "#fffdf8", "strokeWidth": 1.4, "tooltip": true },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "size": { "field": "ptPct", "type": "quantitative", "scale": { "range": [120, 2200] }, "legend": null },
                "color": {
                  "field": "zone", "type": "nominal",
                  "scale": {
                    "domain": ["Inner city", "Inner suburb", "Middle suburb", "Outer suburb", "Peri-urban", "Regional"],
                    "range": ["#063b63", "#1f6fb2", "#4a9ad4", "#80bfe6", "#f0aa4f", "#9e7c5a"]
                  },
                  "legend": null
                },
                "opacity": { "value": 0.88 },
                "tooltip": [
                  { "field": "name", "title": "Area" },
                  { "field": "zone", "title": "Zone" },
                  { "field": "ptPct", "title": "PT use %", "format": ".1f" },
                  { "field": "carPct", "title": "Drove %", "format": ".1f" },
                  { "field": "wfhPct", "title": "WFH %", "format": ".1f" }
                ]
              }
            },
            {
              "data": { "url": "data/victoria_areas.json" },
              "transform": [{ "filter": "datum.zone !== 'Regional'" }],
              "mark": { "type": "text", "dy": -16, "fontSize": 9, "fontWeight": 600, "color": "#172026", "align": "center" },
              "encoding": {
                "longitude": { "field": "lon", "type": "quantitative" },
                "latitude": { "field": "lat", "type": "quantitative" },
                "text": { "field": "name" }
              }
            }
          ]
        }
      ]
    },
    {
      "title": { "text": "Drove vs PT — Victorian LGAs", "anchor": "start", "fontSize": 12, "fontWeight": 700, "color": "#172026" },
      "width": 380,
      "height": 600,
      "data": { "url": "data/victoria_areas.json" },
      "layer": [
        {
          "transform": [{ "regression": "ptPct", "on": "carPct" }],
          "mark": { "type": "line", "color": "#94918a", "strokeDash": [5, 5] },
          "encoding": {
            "x": { "field": "carPct", "type": "quantitative", "scale": { "domain": [10, 75] } },
            "y": { "field": "ptPct", "type": "quantitative", "scale": { "domain": [0, 20] } }
          }
        },
        {
          "mark": { "type": "point", "filled": true, "size": 150, "tooltip": true, "stroke": "#fbfaf6", "strokeWidth": 1.4 },
          "encoding": {
            "x": { "field": "carPct", "type": "quantitative", "title": "Drove to work (%)", "scale": { "domain": [10, 75] } },
            "y": { "field": "ptPct", "type": "quantitative", "title": "Used public transport (%)", "scale": { "domain": [0, 20] } },
            "color": {
              "field": "zone", "type": "nominal",
              "scale": {
                "domain": ["Inner city", "Inner suburb", "Middle suburb", "Outer suburb", "Peri-urban", "Regional"],
                "range": ["#063b63", "#1f6fb2", "#4a9ad4", "#80bfe6", "#f0aa4f", "#9e7c5a"]
              },
              "legend": { "title": "Area type", "orient": "bottom", "columns": 3 }
            },
            "opacity": { "value": 0.9 },
            "tooltip": [
              { "field": "name", "title": "Area" },
              { "field": "zone", "title": "Zone" },
              { "field": "carPct", "title": "Drove %", "format": ".1f" },
              { "field": "ptPct", "title": "PT %", "format": ".1f" },
              { "field": "wfhPct", "title": "WFH %", "format": ".1f" }
            ]
          }
        },
        {
          "transform": [{ "filter": "datum.name === 'Melbourne City' || datum.name === 'Wyndham' || datum.name === 'Ballarat' || datum.name === 'Port Phillip' || datum.name === 'Greater Geelong' || datum.name === 'Yarra'" }],
          "mark": { "type": "text", "dx": 10, "dy": -10, "fontSize": 10, "fontWeight": 700, "color": "#172026", "align": "left" },
          "encoding": {
            "x": { "field": "carPct", "type": "quantitative" },
            "y": { "field": "ptPct", "type": "quantitative" },
            "text": { "field": "name" }
          }
        },
        {
          "data": { "values": [
            { "x": 22, "y": 18, "label": "Inverse relationship:" },
            { "x": 22, "y": 16.8, "label": "more driving = less PT" }
          ] },
          "mark": { "type": "text", "fontSize": 10, "fontStyle": "italic", "color": "#5e6a71", "align": "left" },
          "encoding": {
            "x": { "field": "x", "type": "quantitative" },
            "y": { "field": "y", "type": "quantitative" },
            "text": { "field": "label" }
          }
        }
      ]
    }
  ],
  "resolve": { "scale": { "color": "independent" } }
}
