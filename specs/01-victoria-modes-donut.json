{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Composition of how Victorian workers travelled (or did not travel) to work on Census day 2021.",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "config": {
    "background": null,
    "font": "Inter",
    "axis": {
      "gridColor": "#e7e2d8",
      "domainColor": "#bdb6a9",
      "tickColor": "#bdb6a9",
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12,
      "titleFontWeight": 600
    },
    "legend": {
      "labelColor": "#344047",
      "titleColor": "#172026",
      "titleFontSize": 12
    },
    "view": {
      "stroke": null
    }
  },
  "width": "container",
  "height": 320,
  "padding": 6,
  "data": {
    "url": "data/victoria_modes.json"
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "pct",
          "as": "total_pct"
        }
      ]
    },
    {
      "calculate": "datum.pct / datum.total_pct * 100",
      "as": "share"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "arc",
        "innerRadius": 86,
        "outerRadius": 148,
        "tooltip": true,
        "stroke": "#fbfaf6",
        "strokeWidth": 2
      },
      "encoding": {
        "theta": {
          "field": "pct",
          "type": "quantitative",
          "stack": true
        },
        "order": {
          "field": "pct",
          "sort": "descending"
        },
        "color": {
          "field": "mode",
          "type": "nominal",
          "scale": {
            "domain": [
              "Car (as driver)",
              "Worked from home",
              "Did not go to work",
              "Public transport",
              "Car (as passenger)",
              "Walked only",
              "Other / not stated",
              "Bicycle"
            ],
            "range": [
              "#c83f32",
              "#2f8f5b",
              "#9aa6ac",
              "#1f6fb2",
              "#e5a09a",
              "#d9852b",
              "#82909a",
              "#7b4fa1"
            ]
          },
          "legend": {
            "title": "Mode of travel",
            "orient": "bottom",
            "columns": 2,
            "labelLimit": 200
          }
        },
        "tooltip": [
          {
            "field": "mode",
            "title": "Mode"
          },
          {
            "field": "pct",
            "title": "% of Victorian workers",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "dy": -10,
        "fontSize": 30,
        "fontWeight": 800,
        "color": "#172026"
      },
      "data": {
        "values": [
          {
            "label": "50.3%"
          }
        ]
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "dy": 18,
        "fontSize": 11,
        "color": "#5d686f"
      },
      "data": {
        "values": [
          {
            "label": "drove to work (as driver)"
          }
        ]
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "dy": 34,
        "fontSize": 10,
        "color": "#8b8e8a",
        "fontStyle": "italic"
      },
      "data": {
        "values": [
          {
            "label": "Census 2021, 12.0M Australians"
          }
        ]
      },
      "encoding": {
        "text": {
          "field": "label"
        }
      }
    }
  ]
}
